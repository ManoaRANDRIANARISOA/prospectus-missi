{
  "hosting": [
    {
      "target": "missi-innovation",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "redirects": [
        { "source": "/prospectus_presentation_visuelle.html", "destination": "/education/presentation-visuelle", "type": 301 },
        { "source": "/proposition_commerciale_petite_structure.html", "destination": "/education/offre-petite-structure", "type": 301 },
        { "source": "/proposition_commerciale_moyenne_structure.html", "destination": "/education/offre-moyenne-structure", "type": 301 },
        { "source": "/proposition_commerciale_grande_structure.html", "destination": "/education/offre-grande-structure", "type": 301 },
        { "source": "/proposition_commerciale.html", "destination": "/education/proposition-papier-art", "type": 301 },
        { "source": "/proposition_commerciale_bento_glass.html", "destination": "/education/proposition-bento-glass", "type": 301 },
        { "source": "/perspectives_ameliorations_atelier_3d.html", "destination": "/education/perspectives-atelier-3d", "type": 301 },
        { "source": "/perspectives_ameliorations_bento_ui.html", "destination": "/education/perspectives-bento-ui", "type": 301 },
        { "source": "/proposition_commerciale_societe.html", "destination": "/entreprises/erp-societe", "type": 301 },
        { "source": "/resipro_proposition_commerciale.html", "destination": "/hotellerie/resipro", "type": 301 },
        { "source": "/onepage_site_vitrine_commerciale.html", "destination": "/web/site-vitrine", "type": 301 },
        { "source": "/guide_utilisateur_et_avantages_pro.html", "destination": "/docs/guide-utilisateur", "type": 301 },
        { "source": "/guide_sauvegardes_et_topologie_multipostes.html", "destination": "/docs/guide-sauvegardes-multipostes", "type": 301 },
        { "source": "/multi-tenant-guide.html", "destination": "/docs/guide-architecture-multi-tenant", "type": 301 },
        { "source": "/education/freinet", "destination": "/education/study-agent-freinet", "type": 301 },
        { "source": "/freinet", "destination": "/education/study-agent-freinet", "type": 301 },
        { "source": "/img/:path*", "destination": "/assets/img/:path*", "type": 301 }
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|gif|png|webp|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000"
            }
          ]
        },
        {
          "source": "**/*.@(html|css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=3600"
            }
          ]
        },
        {
          "source": "/admin",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/admin/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ]
    },
    {
      "target": "missi-inovation",
      "public": "public-redirect",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "redirects": [
        {
          "regex": "^/(.*)$",
          "destination": "https://missi-innovation.web.app/:1",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  }
}
